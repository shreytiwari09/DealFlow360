# ---------------------------------------------------------------------------
# DealFlow360 - example environment file
# SECURITY_SPEC.md Section 8: placeholders ONLY. Never commit real secrets.
# Copy to .env and fill in for local development.
# ---------------------------------------------------------------------------

# --- Environment -----------------------------------------------------------
# development | test | production
ENVIRONMENT=development
DEBUG=true

# --- PostgreSQL ------------------------------------------------------------
# These are consumed by the "db" service in docker-compose.yml.
# The app DB user is intentionally NOT the postgres superuser in production
# (SECURITY_SPEC.md Section 6 - least privilege).
POSTGRES_USER=dealflow
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=dealflow360
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Backend ---------------------------------------------------------------
BACKEND_PORT=8000

# JWT signing secret. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECURITY_SPEC.md Section 9: 256-bit+ cryptographically random secret.
JWT_SECRET_KEY=replace-with-a-256-bit-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=dealflow360
JWT_AUDIENCE=dealflow360-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ------------------------------------------------------------------
# Explicit allowlist. SECURITY_SPEC.md Section 5: never wildcard + credentials.
CORS_ORIGINS=http://localhost:5173

# --- Frontend --------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
