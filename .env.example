# ---------------------------------------------------------------------------
# DealFlow360 - example environment file
# SECURITY_SPEC.md Section 8: placeholders ONLY. Never commit real secrets.
# Copy to .env and fill in for local development.
# ---------------------------------------------------------------------------

# --- Environment -----------------------------------------------------------
# development | test | production
ENVIRONMENT=development
DEBUG=true

# --- PostgreSQL ------------------------------------------------------------
# Postgres runs on the HOST machine (not a Docker container - see
# PROJECT_CONTEXT.md's "Database" section and README.md for the one-time
# local setup: create this role and database, then fill in the real values
# below). The app DB user is intentionally NOT the postgres superuser
# (SECURITY_SPEC.md Section 6 - least privilege).
#
# POSTGRES_HOST=host.docker.internal is what lets the backend container (on
# Docker Desktop for Windows/Mac) reach Postgres running on the host - do not
# change this to "localhost", which inside the container means the container
# itself. POSTGRES_PORT is whatever your local Postgres actually listens on
# (5432 is the Postgres default, but a machine that also has another Postgres
# installed - or previously ran this project's own Dockerized Postgres on
# 5432 - may need a different port; check with `pg_isready` or your local
# Postgres's postgresql.conf).
POSTGRES_USER=dealflow
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=dealflow360
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432

# --- Backend ---------------------------------------------------------------
BACKEND_PORT=8000

# JWT signing secret. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECURITY_SPEC.md Section 9: 256-bit+ cryptographically random secret.
JWT_SECRET_KEY=replace-with-a-256-bit-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=dealflow360
JWT_AUDIENCE=dealflow360-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ------------------------------------------------------------------
# Explicit allowlist. SECURITY_SPEC.md Section 5: never wildcard + credentials.
CORS_ORIGINS=http://localhost:5173

# --- Frontend --------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# Read by the BACKEND to build the invite-activation link returned by
# POST /admin/users/invite. Change this if the frontend is ever served from
# somewhere other than localhost:5173.
FRONTEND_BASE_URL=http://localhost:5173

# --- Signup ------------------------------------------------------------------
# Public Sales Rep self-signup (POST /auth/signup). On for the hackathon demo;
# set to false before any real production deployment - see PROJECT_CONTEXT.md.
ALLOW_PUBLIC_SIGNUP=true

# --- Email (invitations) -----------------------------------------------------
# Points at the Mailpit container in docker-compose.yml by default - a local
# dev mail catcher, not a real mail server. Open http://localhost:8025 to read
# anything the app sends (invite links, etc.) without any real email account.
# Replace with a real provider's host/port/credentials for production; the
# app speaks plain SMTP either way, no code change needed.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM=DealFlow360 <no-reply@dealflow360.example>
SMTP_WEB_URL=http://localhost:8025
